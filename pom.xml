<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.tix</groupId>
  <artifactId>tix-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>tix-platform</name>
  <description>Ticket selling platform - Walking skeleton (HU 01.3)</description>

  <modules>
    <module>libs/contracts</module>
    <module>api</module>
    <module>worker</module>
    <module>waiting-room</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- HU 01.3 task 3: coverage >= 80% lines in domain/application.
         The threshold comes from the HU; the gate is tolerant of there being no
         classes (see the EMPTY-TOLERANT note in the jacoco rule below). -->
    <jacoco.line.min>0.80</jacoco.line.min>

    <!-- Plugins: Spring Boot does not manage them, so they go with an explicit version. -->
    <jacoco.version>0.8.15</jacoco.version>
    <spotless.version>3.10.3</spotless.version>
    <checkstyle.plugin.version>3.6.0</checkstyle.plugin.version>
    <checkstyle.version>14.3.0</checkstyle.version>
  </properties>

  <!--
    HU 01.3 task 2 - Testcontainers with real PostgreSQL, Redis and Kafka.

    No version is declared: spring-boot-dependencies 4.0.0 imports
    testcontainers-bom (2.0.2), which manages all three. Pinning the version here
    would fight the BOM without gaining anything.

    WATCH OUT for the names: in Testcontainers 2.x all modules were renamed to
    testcontainers-<name>. The short names (org.testcontainers:postgresql,
    org.testcontainers:junit-jupiter) are from 1.x and do NOT exist in 2.x; they give
    "version is missing" because the BOM does not know them.

    Redis is the double exception: it is not in testcontainers-bom (Spring Boot
    manages it separately, version 2.2.4) and its groupId changed to com.redis. That
    is, com.redis:testcontainers-redis, not org.testcontainers:testcontainers-redis.
  -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.redis</groupId>
      <artifactId>testcontainers-redis</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle.plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- ============================ HU 01.3 / task 3: coverage =============== -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <!--
                EMPTY-TOLERANT, ON PURPOSE.

                The domain/application packages exist but are empty: the first real
                code arrives with HU 02.1 (POST /register). Today the project has
                nothing to measure there, so the bundle filters out empty and the
                check passes with nothing to measure. As soon as there is a class,
                the gate starts demanding 80% by itself, without touching anything.

                To verify that a PR does not drop below 80%: mvn
                -Djacoco.line.min=0.99 verify (it must fail).

                The package filter goes HERE and not inside <rule>. Tested: the
                <includes> of the rule always matches empty (tested with slash
                notation, dot notation and even empty) and the gate stays dead
                forever without warning. The <includes> of the goal does filter, and
                it is verified by adding a class without tests and watching the build
                fail.
              -->
              <includes>
                <include>com/tix/**/domain/**</include>
                <include>com/tix/**/application/**</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ============================ HU 01.3 / task 4: format and lint ======== -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <style>AOSP</style>
            </googleJavaFormat>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <!-- check runs on verify: if the code is unformatted, the build fails.
               apply is local: mvn spotless:apply -->
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <id>checkstyle-validate</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
              <includeTestSourceDirectory>true</includeTestSourceDirectory>
              <consoleOutput>true</consoleOutput>
              <failOnViolation>true</failOnViolation>
              <violationSeverity>error</violationSeverity>
              <logViolationsToConsole>true</logViolationsToConsole>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ==================== deterministic tests (HU 01.3 / task 2) ============ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            -Duser.timezone=UTC is NOT cosmetic: it is what makes the PostgreSQL
            Testcontainers gate reproducible.

            The PostgreSQL driver sends the JVM default timezone as the "TimeZone"
            startup parameter. The postgres:17 image (Debian slim) does not ship
            America/Buenos_Aires in its tzdata and the server rejects it with:

              PSQL FATAL: invalid value for parameter "TimeZone": "America/Buenos_Aires"

            Without this, the test passes on a UTC runner and fails on any machine in
            Argentina or Uruguay. Tested: passing TimeZone=UTC in the JDBC URL is NOT
            enough, the driver overrides it with the JVM timezone.

            @{argLine} keeps the JaCoCo agent, which prepare-agent leaves in that same
            property. Without this, coverage would be lost silently.
          -->
          <argLine>@{argLine} -Duser.timezone=UTC</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
