<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    This module used to declare spring-boot-starter-parent 4.1.1 as a direct
    parent, which meant: (1) it inherited nothing from tix-platform and the HU 01.3
    quality gates skipped it silently, and (2) the reactor mixed Spring Boot 4.1.1
    with the 4.0.0 of the rest of the platform. Now it inherits from the root, just
    like api and waiting-room.
  -->
  <parent>
    <groupId>com.tix</groupId>
    <artifactId>tix-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>worker</artifactId>
  <name>worker</name>
  <description>Event consumer: projections, outbox and asynchronous work</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
