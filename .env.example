# Copy to .env and change whatever is needed. .env is in .gitignore:
# it is never versioned (AC 5 of HU 01.1).

# --- Credentials ------------------------------------------------------------
# Without this the compose stack does not start: POSTGRES_PASSWORD is required.
# Watch out for special characters (@ : / ? #): they travel in the connection URL.
POSTGRES_PASSWORD=change-me
# Redis runs with --requirepass, so this is mandatory too. It travels inside
# REDIS_URL: same warning about special characters.
REDIS_PASSWORD=change-me
# JWT_SECRET needs at least 32 characters (256 bits): FailFastConfig rejects a shorter
# one and the app refuses to start. This placeholder is short on purpose.
JWT_SECRET=change-me

# --- Ports published on the host --------------------------------------------
# Change them if something on the host already uses them: no need to touch the compose file.
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379
KAFKA_PORT=9092
API_PORT=8080

# --- App running OUTSIDE Docker (host) --------------------------------------
# Two different URLs on purpose: Flyway migrations go against DIRECT Postgres and
# the app traffic goes through PgBouncer (AC 4).
DB_URL=jdbc:postgresql://localhost:5432/tickets
POOL_URL=jdbc:postgresql://localhost:6432/tickets
DB_USER=app
DB_PASSWORD=change-me            # must match POSTGRES_PASSWORD
REDIS_URL=redis://localhost:6379
REDIS_LOCKS_URL=redis://localhost:6379
# Kafka advertises localhost:9092 for clients outside the container.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Inside Docker the hosts change: compose/full.yml already defines them
# (postgres:5432, pgbouncer:5432, kafka:29092).

# --- App image (full profile) -----------------------------------------------
# Built by HU 08.1.
API_IMAGE=tix-api:local

# --- Observability (obs profile) --------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_PORT=12345
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
# Local development credentials only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
