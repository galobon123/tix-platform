# Copiar a .env y cambiar lo que haga falta. El .env esta en .gitignore:
# nunca se versiona (CA 5 de la HU 01.1).

# --- Credenciales -----------------------------------------------------------
# Sin esto el compose no arranca: POSTGRES_PASSWORD es obligatorio.
# Ojo con caracteres especiales (@ : / ? #): viaja en la URL de conexion.
POSTGRES_PASSWORD=change-me

# --- Puertos publicados en el host -----------------------------------------
# Cambialos si algo del host ya los ocupa: no hace falta tocar el compose.
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379
KAFKA_PORT=9092
API_PORT=8080

# --- App corriendo FUERA de Docker (host) ----------------------------------
# Dos URLs distintas a proposito: las migraciones de Flyway van contra el
# Postgres DIRECTO y el trafico de la app contra PgBouncer (CA 4).
DB_URL=jdbc:postgresql://localhost:5432/tickets
POOL_URL=jdbc:postgresql://localhost:6432/tickets
DB_USER=app
DB_PASSWORD=change-me            # tiene que ser igual a POSTGRES_PASSWORD
REDIS_URL=redis://localhost:6379
REDIS_LOCKS_URL=redis://localhost:6379
# Kafka anuncia localhost:9092 para clientes externos al contenedor.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Dentro de Docker los hosts cambian: compose/full.yml ya los define
# (postgres:5432, pgbouncer:5432, kafka:29092).

# --- Imagen de la app (perfil full) -----------------------------------------
# La construye HU 08.1.
API_IMAGE=tix-api:local

# --- Observabilidad (perfil obs) --------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_PORT=12345
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
# Credenciales solo de desarrollo local.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin